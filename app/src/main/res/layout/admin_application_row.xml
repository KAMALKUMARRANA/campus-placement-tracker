<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp"
    android:layout_marginVertical="4dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/cardBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/rowAdminStudent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Student: username"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/textGray"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:id="@+id/rowAdminCompany"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Company Name"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/primaryBlue" />

        <TextView
            android:id="@+id/rowAdminRole"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Role and Package"
            android:textSize="14sp"
            android:textColor="@color/textDark"
            android:layout_marginTop="2dp" />

        <TextView
            android:id="@+id/rowAdminQuickInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CGPA | Skills"
            android:textSize="12sp"
            android:textColor="@color/primaryBlue"
            android:textStyle="italic"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/rowAdminStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Status: Applied"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginTop="8dp"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:background="#E3F2FD" />

    </LinearLayout>
</androidx.cardview.widget.CardView>
